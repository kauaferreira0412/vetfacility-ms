# Copie este arquivo para ".env" e ajuste os valores antes de rodar "docker compose up".
# Nunca commitar o arquivo .env real (ja esta no .gitignore).

POSTGRES_DB=vetfacility
POSTGRES_USER=vetfacility
POSTGRES_PASSWORD=troque_esta_senha

DB_URL=jdbc:postgresql://db:5432/vetfacility
DB_USERNAME=vetfacility
DB_PASSWORD=troque_esta_senha

JWT_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credenciais do usuario ROOT (administrador da plataforma), criado automaticamente no primeiro start.
ROOT_EMAIL=root@vetfacility.local
ROOT_PASSWORD=TrocarSenha123!

BACKEND_PORT=8080
