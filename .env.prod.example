# Copie este arquivo para .env.prod e preencha. NAO commite o .env.prod de verdade
# (ja fica coberto pelo .gitignore).
#
# Uso (VPS dedicada, com o Caddy deste proprio projeto - ver DEPLOY.md):
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.caddy.yml up -d --build

POSTGRES_DB=vetfacility
POSTGRES_USER=vetfacility
POSTGRES_PASSWORD=troque-esta-senha

DB_URL=jdbc:postgresql://db:5432/vetfacility
DB_USERNAME=vetfacility
DB_PASSWORD=troque-esta-senha

JWT_EXPIRATION_SECONDS=3600

# Dominio publico da aplicacao (usado pelo Caddy para emitir o certificado HTTPS automatico
# e pelo backend para liberar CORS). Se ainda nao tiver um dominio proprio apontado pra VPS,
# use o truque do sslip.io: <IP-DA-VPS-COM-TRACOS>.sslip.io resolve automaticamente pro IP
# (ex.: VPS no IP 187.127.37.101 -> DOMAIN=187-127-37-101.sslip.io).
DOMAIN=troque-para-seu-dominio-ou-ip.sslip.io
CORS_ALLOWED_ORIGINS=https://troque-para-seu-dominio-ou-ip.sslip.io

# Credenciais do usuario ROOT (administrador da plataforma), criado automaticamente no primeiro
# start. TROQUE OS DOIS - os valores de exemplo do README sao publicos (usados no piloto local).
ROOT_EMAIL=root@vetfacility.local
ROOT_PASSWORD=troque-esta-senha-tambem

BACKEND_PORT=8080
